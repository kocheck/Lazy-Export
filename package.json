{
  "name": "lazy-export",
  "version": "2.0.0",
  "description": "Modern Figma plugin for quick export preset management with batch directory generation",
  "scripts": {
    "dev": "npm run build:plugin && vite build --mode development --watch",
    "build": "npm run build:plugin && vite build",
    "build:plugin": "node build-plugin.js",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.90.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "^4.1.8",
    "esbuild": "^0.28.1",
    "happy-dom": "^20.0.11",
    "jsdom": "^27.4.0",
    "typescript": "^5.3.3",
    "vite": "^8.0.16",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.8"
  }
}
